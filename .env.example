APP_NAME=Material Didactico YouTube API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.0-flash
YOUTUBE_API_KEY=replace_with_your_key
YOUTUBE_MAX_RESULTS=10
SQLITE_DATABASE_URL=sqlite:///./data/metadata/app.db
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=video_transcript_chunks
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAW_TRANSCRIPTS_DIRECTORY=./data/transcripts/raw
PROCESSED_TRANSCRIPTS_DIRECTORY=./data/transcripts/processed
EXPORTS_DIRECTORY=./data/exports

