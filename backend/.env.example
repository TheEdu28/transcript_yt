GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-2.0-flash
# Genera un valor largo y aleatorio por entorno; nunca lo subas al repositorio.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_VIDEO_DURATION_SECONDS=3600
CHUNK_WORDS=220
CHUNK_OVERLAP_SEGMENTS=2
RAG_RETRIEVAL_LIMIT=6
MAX_GEMINI_CONTEXT_CHARS=12000
MAX_GEMINI_OUTPUT_TOKENS=4096
# Archivo de cookies Netscape exportado desde el navegador autenticado.
# No agregues este archivo al repositorio.
YTDLP_COOKIE_FILE=../data/cookies.txt
CHROMA_PERSIST_DIRECTORY=../data/chroma_db
CHROMA_COLLECTION_NAME=transcript_chunks
SQLITE_DATABASE_URL=sqlite:///../data/metadata/app.db
RAW_TRANSCRIPTS_DIRECTORY=../data/transcripts/raw
PROCESSED_TRANSCRIPTS_DIRECTORY=../data/transcripts/processed
