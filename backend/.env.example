GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-2.0-flash
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_VIDEO_DURATION_SECONDS=3600
CHUNK_WORDS=220
CHUNK_OVERLAP_SEGMENTS=2
RAG_RETRIEVAL_LIMIT=6
MAX_GEMINI_CONTEXT_CHARS=12000
MAX_GEMINI_OUTPUT_TOKENS=1800
CHROMA_PERSIST_DIRECTORY=../data/chroma_db
CHROMA_COLLECTION_NAME=transcript_chunks
SQLITE_DATABASE_URL=sqlite:///../data/metadata/app.db
RAW_TRANSCRIPTS_DIRECTORY=../data/transcripts/raw
PROCESSED_TRANSCRIPTS_DIRECTORY=../data/transcripts/processed
